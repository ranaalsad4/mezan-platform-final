# Mezan | ميزان — optional configuration. Copy to .env (or set in your shell) only if you want language-model
# explanations. The platform runs fully without any of these: a deterministic explanation is used instead.
# Never commit real keys.

# "openai" (any OpenAI-compatible /chat/completions endpoint) or "anthropic"
MEZAN_LLM_PROVIDER=openai
MEZAN_LLM_API_KEY=
MEZAN_LLM_MODEL=
# Optional: custom endpoint (e.g. a self-hosted OpenAI-compatible server)
MEZAN_LLM_BASE_URL=
MEZAN_LLM_TIMEOUT=30
